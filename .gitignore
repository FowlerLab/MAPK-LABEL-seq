output/
# `data/*` rather than `data/`: git cannot un-ignore a file inside an ignored
# DIRECTORY, so the negation below only works if the directory itself is not
# excluded. The DN threshold table is small enough to version and the
# dominant-negative step needs it.
data/*
!data/dn_cutoffs_empty_vector.tsv

